{
  "version": 2,
  "builds": [
    {
      "src": "tax-engine/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "tax-engine/main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/billing/reset-monthly-counters",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
