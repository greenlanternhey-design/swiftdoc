{
  "builds": [
    {
      "src": "tax-engine/main.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["tax-engine/**"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "tax-engine/main.py" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 6 * * *" },
    { "path": "/api/billing/reset-monthly-counters", "schedule": "0 0 1 * *" }
  ]
}
